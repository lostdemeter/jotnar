# baked/cached artifacts (built locally, never uploaded)
# NOTE: chain/M.json and chain/CTRL.json are FROZEN doctrine artifacts
# (calibration + controller fit) and MUST be tracked -- never ignore them.
*.npy
# Phase-0 teacher fixtures (small banked .npy + manifest, see samples/marigold/)
!samples/marigold/*.npy
# ENGRAM blobs (41MB full float64 dwarfs the repo; regenerable, gated)
stores/*.npz
*.pth
*.pt
*.bin
weights/
luts/
captures/
mid_*/
seq*/
*.log
__pycache__/
*.pyc
.tmp/
# runtime/data artifacts (built locally, never uploaded).
# data/ holds ONLY the 9 small emission-gate fixtures (see data/README.md);
# everything else a run needs is rebuilt or downloaded, never committed.
data/*
!data/README.md
data_ingest/
